{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "type": "update", "release": "patch" },
          { "type": "ui", "release": "patch" },
          { "type": "perf", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./gradlew -PreleaseVersion=${nextRelease.version} :components:publishReleasePublicationToGitHubPackagesRepository"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "assets": [
          {
            "path": "components/build/outputs/aar/components-release.aar",
            "label": "Compose Components Android library"
          },
          {
            "path": "showcase/build/outputs/apk/debug/showcase-debug.apk",
            "label": "Compose Components showcase APK"
          }
        ]
      }
    ]
  ]
}
